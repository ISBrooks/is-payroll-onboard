# Commissions engine settings. Copy this file to .env (never commit .env) and fill it.
# Keys left commented out have a built-in default; an empty value would override it.

# ---- FieldRoutes (PestRoutes) API: read-only access to your offices ----
PESTROUTES_BASE_URL=https://yourcompany.pestroutes.com/api
PESTROUTES_AUTH_KEY=
PESTROUTES_AUTH_TOKEN=
# office ids, comma-separated (required: with none, nothing is synced)
PESTROUTES_OFFICE_IDS=
# the time zone FieldRoutes shows your office times in (required), e.g. America/Denver.
# Decides which week of a pay period an event near midnight falls in.
OFFICE_TIMEZONE=

# ---- the dashboard: who is paid comes from its Payroll -> Commission Roster ----
# path of the dashboard's database (read-only). Default: ../is-dash/data/isadash.sqlite
#ISADASH_DB=/home/isdash/is-dash/data/isadash.sqlite
# 'dashboard' (normal) or 'env' (a test laptop with no dashboard: then ISA_ROSTER and
# OUTBOUND_AGENTS below are used instead of the roster)
#ROSTER_SOURCE=dashboard
#ISA_ROSTER=Pat Example,Sam Example
#OUTBOUND_AGENTS=Robin Vale
# inside-sales start dates for reps who moved into inside sales (rules §1a), only when
# the roster's own start-date column is not used: Pat Example=2026-01-15; Sam Example=2026-02-01
#ISA_REP_START_DATES=

# ---- pay calendar and go-live (COMMISSION_RULES.md §8): all required, YYYY-MM-DD ----
# The engine checks at every start that these four fit together.
# the payroll Monday of the first period the app calculates (= GO_LIVE_PERIOD_START + 15
# days); fixes the 14-day Sun-Sat grid. Must equal the dashboard's PAYROLL_ANCHOR_MONDAY.
PAYROLL_ANCHOR_MONDAY=
# how far back FieldRoutes history is synced: at least 12 months before go-live
BACKFILL_SINCE=
# first day (a Sunday) of the first period the app calculates (the parallel run starts
# here). Sales first paid before it count as paid by the manual payroll, and the Moved /
# re-signed / cancellation-fee rules (§5) apply to cancels from this day on.
GO_LIVE_PERIOD_START=
# first day of the first period PAID from the app: a whole number of 14-day periods after
# GO_LIVE_PERIOD_START. Must equal the dashboard's PAYROLL_LIVE_FROM.
PAYROLL_LIVE_FROM=
# the moment (UTC, YYYY-MM-DD HH:MM:SS) your manual payroll's last adjustments list was
# made: upsells and splits booked in the app after it are the app's to pay. Set at the
# switch-over (ONBOARDING.md phase 6), then never changed.
CUTOVER_LIST_AT_UTC=
# adjustment-form rows on or before this were booked by the manual payroll. Default:
# the end of the day before PAYROLL_LIVE_FROM
#FORM_INTAKE_SINCE=

# ---- rates (COMMISSION_RULES.md §3, §14): defaults are the rules as written ----
# A rate is a rule: change one only as a recorded decision. Some rule amounts are written
# in the code, not here (upsell credits 9% of the contract-value change, the true-up cap,
# the outbound split share): changing RATE_STANDARD alone does not change those.
#RATE_STANDARD=0.09
#RATE_ALT_SOURCE=0.05
#RATE_NO_PAYMENT_METHOD=0.03
#RATE_COMMERCIAL=0.05
#RATE_MANAGER=0.05
# FieldRoutes source names paid at RATE_ALT_SOURCE, comma-separated, as FieldRoutes
# spells them (a source with "renewal" in its name always is)
ALT_RATE_SOURCES=
# business-only plans paid at RATE_COMMERCIAL: FieldRoutes service-type descriptions,
# comma-separated (a customer card marked Commercial Property always is)
COMMERCIAL_SERVICE_TYPES=
#VESTING_SERVICE_COUNT=3
#FULL_INITIAL_FLOOR=299

# ---- optional: a Google Form for adjustments. Without GSHEET_ID only the dashboard's
# Submit Adjustment form is used (the usual way). The spreadsheet the form writes to, and a service-account key
# file (path relative to this folder) shared on that spreadsheet.
#GSHEET_ID=
#GOOGLE_SA_JSON=secrets/google-sa.json

# ---- not used yet (an emailed report was planned, never built) ----
#RESEND_API_KEY=
#RESEND_FROM=
#RESEND_TO=
